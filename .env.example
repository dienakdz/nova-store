# Public HTTP port; Caddy redirects it to HTTPS.
WORDPRESS_PORT=8080
HTTPS_PORT=8443
HTTPS_HOST=localhost
DB_PORT=3308

DB_NAME=nova_store
DB_USER=nova_store
DB_PASSWORD=nova_password
DB_ROOT_PASSWORD=nova_password

WORDPRESS_DEBUG=1

WP_URL=https://localhost:8443
WP_TITLE=Nova Store
WP_TAGLINE=Thời trang hiện đại cho phong cách hằng ngày
# Chỉ dùng thông tin mẫu này ở local; hãy đổi mật khẩu trước khi deploy public.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin_password
WP_ADMIN_EMAIL=admin@example.com

# Ghim phiên bản để các máy trong team cài cùng một bản WooCommerce.
WOOCOMMERCE_VERSION=11.0.1
