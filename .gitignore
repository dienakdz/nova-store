# Cấu hình riêng và mật khẩu local; chỉ commit file mẫu `.env.example`.
.env
.env.local
.env.*.local
!.env.example

# WordPress core do Docker tạo; vẫn dùng để chạy nhưng không cần commit.
/app/*

# Cho phép Git theo dõi custom code trong wp-content.
!/app/wp-content/

# Bỏ qua uploads, cache, languages và code tải từ WordPress Admin.
/app/wp-content/*

!/app/wp-content/plugins/
!/app/wp-content/themes/

# Bỏ qua plugin bên thứ ba như WooCommerce; setup sẽ cài lại.
/app/wp-content/plugins/*

# Chỉ commit plugin do dự án viết.
!/app/wp-content/plugins/nova-review-bridge/

# Bỏ qua theme mặc định và theme tải ngoài.
/app/wp-content/themes/*

# Chỉ commit theme do dự án viết.
!/app/wp-content/themes/nova-theme/

# Log, database dump và file backup local.
*.log
*.sql
*.zip
*.tar
*.tar.gz
*.tgz

# File riêng của hệ điều hành và editor.
.DS_Store
Thumbs.db
.idea/
.vscode/

# CA nội bộ phụ thuộc từng máy/mạng, không commit.
/docker/wordpress/certs/*.crt
/docker/wordpress/certs/*.der
